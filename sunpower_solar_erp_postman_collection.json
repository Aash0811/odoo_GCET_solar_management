            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"REPLACE_WITH_LEAD_ID\",\n  \"scheduledAt\": \"2026-11-05T10:00:00.000Z\",\n  \"notes\": \"Check shadow from south-facing parapet wall\"\n}"
            },
            "url": {
