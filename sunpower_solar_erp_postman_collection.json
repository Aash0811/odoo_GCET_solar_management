              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"5kW Rooftop Villa Project\",\n  \"contactName\": \"Kavita Sharma\",\n  \"phone\": \"9876543299\",\n  \"email\": \"kavita@gmail.com\",\n  \"address\": \"Banjara Hills, Hyderabad\",\n  \"desiredCapacityKw\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads",
              "host": ["{{baseUrl}}"],
              "path": ["leads"]
            }
          }
        },
        {
          "name": "Schedule Site Survey",
