# SunPower Backend Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
# Example Supabase / Neon: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solar_management?schema=public"

# Authentication
JWT_SECRET=solar_secret_jwt_key_hackathon_2026_super_secure

# Optional: Cloudinary Storage (Local base64 fallback is used automatically if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
