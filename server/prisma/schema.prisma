generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  SALESMAN
  ACCOUNTANT
  WAREHOUSE
  TECHNICIAN
  SUPPORT
  CUSTOMER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  SURVEY_SCHEDULED
  SURVEY_DONE
  SURVEY_APPROVED
  QUOTED
  WON
  LOST
}

enum SurveyStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum PackageType {
  ON_GRID
  OFF_GRID
  PANEL_SET
  INSTALLATION
}

enum ProductType {
  HARDWARE
  SERVICE
  PACKAGE
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PICKING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  INSTALLATION_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PickListStatus {
  OPEN
  PICKING
  COMPLETED
  CANCELLED
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  DISPATCHED
  INSTALLED
  REPLACED
  RETURNED
}

enum DeliveryStatus {
  DRAFT
  VALIDATED
  DELIVERED
  CANCELLED
}

enum JobStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CUSTOMER_CONFIRMED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketLineType {
  PART
  LABOUR
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum SubsidyStatus {
  NOT_STARTED
  DOCUMENTS_PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RECEIVED
}

enum StockMoveType {
  PURCHASE
  RESERVATION
  RELEASE
  DISPATCH
  RETURN
  ADJUSTMENT
  REPLACEMENT
}

enum NotificationType {
  LEAD_ASSIGNED
  SURVEY_ASSIGNED
  ORDER_CONFIRMED
  PICK_LIST_CREATED
  JOB_CREATED
  JOB_ASSIGNED
  DISPATCH_READY
  DELIVERY_COMPLETED
  WARRANTY_EXPIRING
  TICKET_CREATED
  TICKET_ASSIGNED
  PAYMENT_RECEIVED
  GENERAL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  ARCHIVE
  LOGIN
  LOGOUT
  DELETE
  PAYMENT_RECORDED
  SERIAL_SCANNED
  DELIVERY_VALIDATED
  SIGNATURE_CAPTURED
  DOCUMENT_UPLOADED
}

// ============================================================
// COMPANY AND AUTHENTICATION
// ============================================================

model Company {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  email     String?
  phone     String?
  address   String?
  gstNumber String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  customers           Customer[]
  leads               Lead[]
  products            Product[]
  packageTemplates    PackageTemplate[]
  quotes              Quote[]
  orders              SalesOrder[]
  payments            Payment[]
  pickLists           PickList[]
  serialNumbers       SerialNumber[]
  deliveries          Delivery[]
  warranties          Warranty[]
  installationJobs    InstallationJob[]
  tickets             Ticket[]
  invoices            Invoice[]
  subsidyApplications SubsidyApplication[]
  timeEntries         TimeEntry[]
  costEntries         CostEntry[]
  stockMoves          StockMove[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  shareLinks          DashboardShareLink[]
  paymentMilestones   PaymentMilestone[]

  @@index([isActive])
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  email        String?
  phone        String?
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  assignedLeads    Lead[]            @relation("LeadAssignee")
  createdQuotes    Quote[]           @relation("QuoteCreator")
  createdOrders    SalesOrder[]      @relation("OrderCreator")
  createdPickLists PickList[]        @relation("PickListCreator")
  assignedJobs     InstallationJob[] @relation("JobTechnician")
  createdTickets   Ticket[]          @relation("TicketCreator")
  assignedTickets  Ticket[]          @relation("TicketAssignee")
  createdInvoices  Invoice[]         @relation("InvoiceCreator")
  timeEntries      TimeEntry[]
  notifications    Notification[]
  auditLogs        AuditLog[]        @relation("AuditActor")

  @@unique([companyId, email])
  @@unique([companyId, phone])
  @@index([companyId, role, isActive])
}

// ============================================================
// CUSTOMERS AND LEADS
// ============================================================

model Customer {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String
  alternatePhone String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  notes          String?
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  leads               Lead[]
  quotes              Quote[]
  orders              SalesOrder[]
  serialNumbers       SerialNumber[]
  deliveries          Delivery[]
  warranties          Warranty[]
  installationJobs    InstallationJob[]
  tickets             Ticket[]
  invoices            Invoice[]
  subsidyApplications SubsidyApplication[]
  signatures          Signature[]

  @@index([companyId, name])
  @@index([companyId, phone])
  @@index([companyId, email])
}

model Lead {
  id           String  @id @default(cuid())
  companyId    String
  customerId   String?
  assignedToId String?

  title       String
  contactName String
  email       String?
  phone       String
  address     String?
  source      String?
  notes       String?

  stage LeadStage @default(NEW)

  // Qualification checklist
  shadowFreeArea    Boolean  @default(false)
  monthlyBill       Boolean  @default(false)
  gridSuitable      Boolean  @default(false)
  monthlyBillAmount Decimal? @db.Decimal(12, 2)
  desiredCapacityKw Decimal? @db.Decimal(8, 2)

  lossReason    String?
  archivedAt    DateTime?
  lastContactAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  assignedTo User? @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  surveys Survey[]
  quotes  Quote[]

  @@index([companyId, stage, archivedAt])
  @@index([companyId, assignedToId, stage])
  @@index([companyId, phone])
  @@index([companyId, createdAt])
}

// ============================================================
// SURVEYS AND SURVEY PHOTOS
// ============================================================

model Survey {
  id        String @id @default(cuid())
  companyId String
  leadId    String

  status      SurveyStatus @default(REQUESTED)
  scheduledAt DateTime?
  completedAt DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?

  surveyedById    String?
  roofType        String?
  roofAreaSqFt    Decimal? @db.Decimal(10, 2)
  shadowFreeArea  Boolean  @default(false)
  monthlyBill     Boolean  @default(false)
  gridSuitable    Boolean  @default(false)
  recommendedKw   Decimal? @db.Decimal(8, 2)
  notes           String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  photos SurveyPhoto[]

  @@index([companyId, status, scheduledAt])
  @@index([leadId, status])
}

model SurveyPhoto {
  id         String   @id @default(cuid())
  surveyId   String
  url        String
  publicId   String?
  caption    String?
  uploadedAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, uploadedAt])
}

// ============================================================
// PRODUCTS, PACKAGES AND BILL OF MATERIALS
// ============================================================

model Product {
  id        String @id @default(cuid())
  companyId String

  sku         String
  name        String
  category    String
  description String?

  unit            String      @default("unit")
  productType     ProductType @default(HARDWARE)
  isSerialTracked Boolean     @default(false)

  warrantyYears     Int      @default(0)
  laborHours        Decimal? @db.Decimal(8, 2)
  isSubsidyEligible Boolean  @default(true)

  costPrice    Decimal @db.Decimal(12, 2)
  salePrice    Decimal @db.Decimal(12, 2)
  stockQty     Decimal @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal @default(0) @db.Decimal(12, 3)

  gstRate  Decimal @default(18) @db.Decimal(5, 2)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  bomLines      BomLine[]
  quoteLines    QuoteLine[]
  pickLines     PickLine[]
  serialNumbers SerialNumber[]
  ticketLines   TicketLine[]
  invoiceLines  InvoiceLine[]
  stockMoves    StockMove[]

  @@unique([companyId, sku])
  @@index([companyId, category, isActive])
  @@index([companyId, stockQty])
}

model PackageTemplate {
  id        String @id @default(cuid())
  companyId String

  name        String
  description String?
  type        PackageType

  minCapacityKw     Decimal @default(1) @db.Decimal(8, 2)
  maxCapacityKw     Decimal @default(5) @db.Decimal(8, 2)
  defaultCapacityKw Decimal @default(3) @db.Decimal(8, 2)

  basePrice Decimal? @db.Decimal(12, 2)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  bomLines BomLine[]
  quotes   Quote[]

  @@index([companyId, type, isActive])
}

model BomLine {
  id                String @id @default(cuid())
  packageTemplateId String
  productId         String

  // Quantity required per kW of installed capacity.
  quantityPerKw Decimal @db.Decimal(12, 4)

  // Fixed quantity added once per package.
  fixedQuantity Decimal @default(0) @db.Decimal(12, 3)

  notes String?

  packageTemplate PackageTemplate @relation(fields: [packageTemplateId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([packageTemplateId, productId])
  @@index([productId])
}

// ============================================================
// QUOTATIONS
// ============================================================

model Quote {
  id                String @id @default(cuid())
  companyId         String
  customerId        String
  leadId            String
  packageTemplateId String
  createdById       String

  quoteNumber String
  status      QuoteStatus @default(DRAFT)

  capacityKw Decimal @db.Decimal(8, 2)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  gstAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  gstRate     Decimal @default(18) @db.Decimal(5, 2)
  subsidyNote String?
  terms       String?
  notes       String?

  pdfUrl      String?
  pdfPublicId String?

  version                  Int       @default(1)
  validUntil               DateTime?
  shareToken               String?   @unique
  subsidyAmount            Decimal   @default(78000) @db.Decimal(12, 2)
  netPayable               Decimal?  @db.Decimal(12, 2)
  discountApprovalRequired Boolean   @default(false)
  discountApproved         Boolean   @default(true)
  discountApprovedById     String?
  acceptanceIp             String?
  acceptanceUserAgent      String?
  acceptanceSignature      String?
  acceptanceNotes          String?

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  packageTemplate PackageTemplate @relation(fields: [packageTemplateId], references: [id], onDelete: Restrict)

  createdBy User @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  lines  QuoteLine[]
  orders SalesOrder[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([leadId, status])
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  productId String?

  description String
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @default("unit")

  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @default(0) @db.Decimal(12, 2)

  gstRate   Decimal @default(18) @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sortOrder Int @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quoteId, sortOrder])
  @@index([productId])
}

// ============================================================
// SALES ORDERS AND PAYMENTS
// ============================================================

model SalesOrder {
  id          String @id @default(cuid())
  companyId   String
  customerId  String
  quoteId     String
  createdById String

  orderNumber String
  status      OrderStatus @default(PENDING_PAYMENT)

  capacityKw Decimal @db.Decimal(8, 2)

  revenue     Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  gstAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  minAdvancePercent Decimal  @default(30) @db.Decimal(5, 2)
  minAdvanceAmount  Decimal? @db.Decimal(12, 2)

  confirmedAt        DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  lastReminderSentAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  createdBy User @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)

  payments         Payment[]
  pickLists        PickList[]
  serialNumbers    SerialNumber[]
  deliveries       Delivery[]
  installationJobs InstallationJob[]
  tickets          Ticket[]
  invoices         Invoice[]
  timeEntries      TimeEntry[]
  costEntries      CostEntry[]
  stockMoves       StockMove[]
  milestones       PaymentMilestone[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([quoteId])
}

model Payment {
  id        String @id @default(cuid())
  companyId String
  orderId   String

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod
  status PaymentStatus @default(COMPLETED)

  receiptNumber  String?   @unique
  transactionRef String?
  receivedAt     DateTime  @default(now())
  notes          String?

  isVerified   Boolean   @default(true)
  verifiedById String?
  verifiedAt   DateTime?

  milestoneId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  order     SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  milestone PaymentMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([companyId, status, receivedAt])
  @@index([orderId, status])
  @@index([transactionRef])
  @@index([receiptNumber])
}

model PaymentMilestone {
  id         String    @id @default(cuid())
  companyId  String
  orderId    String
  name       String
  stage      String
  percentage Decimal   @db.Decimal(5, 2)
  amount     Decimal   @db.Decimal(12, 2)
  dueDate    DateTime?
  status     String    @default("PENDING")
  paidAmount Decimal   @default(0) @db.Decimal(12, 2)
  paidAt     DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  order    SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([orderId, status])
  @@index([companyId, status])
}

// ============================================================
// WAREHOUSE PICKING AND INVENTORY
// ============================================================

model PickList {
  id          String  @id @default(cuid())
  companyId   String
  orderId     String
  createdById String?

  pickNumber String
  status     PickListStatus @default(OPEN)

  assignedAt  DateTime?
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdBy User? @relation("PickListCreator", fields: [createdById], references: [id], onDelete: SetNull)

  lines PickLine[]

  @@unique([companyId, pickNumber])
  @@unique([orderId])
  @@index([companyId, status, createdAt])
}

model PickLine {
  id         String @id @default(cuid())
  pickListId String
  productId  String

  requiredQty Decimal @db.Decimal(12, 3)
  pickedQty   Decimal @default(0) @db.Decimal(12, 3)

  notes String?

  pickList PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([pickListId, productId])
  @@index([productId])
}

model StockMove {
  id        String  @id @default(cuid())
  companyId String
  productId String
  orderId   String?

  type     StockMoveType
  quantity Decimal       @db.Decimal(12, 3)

  reference String?
  notes     String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  order SalesOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([companyId, productId, createdAt])
  @@index([orderId, type])
}

// ============================================================
// SERIAL NUMBERS, DELIVERIES AND WARRANTIES
// ============================================================

model SerialNumber {
  id        String @id @default(cuid())
  companyId String
  productId String

  orderId    String?
  customerId String?

  serial String
  status SerialStatus @default(IN_STOCK)

  scannedAt   DateTime?
  deliveredAt DateTime?
  installedAt DateTime?

  replacesSerialId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  order SalesOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  replacesSerial SerialNumber? @relation("SerialReplacement", fields: [replacesSerialId], references: [id], onDelete: Restrict)

  replacedBy SerialNumber? @relation("SerialReplacement")

  warranties  Warranty[]
  ticketLines TicketLine[]

  @@unique([companyId, serial])
  @@index([companyId, productId, status])
  @@index([orderId, productId])
  @@index([customerId, status])
}

model Delivery {
  id         String @id @default(cuid())
  companyId  String
  orderId    String
  customerId String

  deliveryNumber String
  status         DeliveryStatus @default(DRAFT)

  deliveryDate DateTime?
  validatedAt  DateTime?
  deliveredAt  DateTime?

  deliveredTo String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([companyId, deliveryNumber])
  @@index([companyId, status, deliveryDate])
  @@index([orderId, status])
}

model Warranty {
  id             String @id @default(cuid())
  companyId      String
  serialNumberId String
  customerId     String

  status WarrantyStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  serialNumber SerialNumber @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([serialNumberId])
  @@index([companyId, status, endDate])
  @@index([customerId, endDate])
}

// ============================================================
// INSTALLATION JOBS, PHOTOS AND SIGNATURES
// ============================================================

model InstallationJob {
  id           String  @id @default(cuid())
  companyId    String
  orderId      String
  customerId   String
  technicianId String?

  jobNumber String
  status    JobStatus @default(SCHEDULED)

  scheduledAt DateTime?
  startTime   DateTime?
  endTime     DateTime?

  confirmedKw   Decimal? @db.Decimal(8, 2)
  notes         String?
  blockedReason String?

  // Mandatory completion checklist.
  standsInstalled   Boolean @default(false)
  panelsInstalled   Boolean @default(false)
  boxesInstalled    Boolean @default(false)
  earthingCompleted Boolean @default(false)
  powerTestPassed   Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  technician User? @relation("JobTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  photos      JobPhoto[]
  signature   Signature?
  timeEntries TimeEntry[]

  @@unique([companyId, jobNumber])
  @@unique([orderId])
  @@index([companyId, status, scheduledAt])
  @@index([technicianId, status, scheduledAt])
  @@index([customerId, createdAt])
}

model JobPhoto {
  id                String @id @default(cuid())
  installationJobId String

  url        String
  publicId   String?
  caption    String?
  uploadedAt DateTime @default(now())

  installationJob InstallationJob @relation(fields: [installationJobId], references: [id], onDelete: Cascade)

  @@index([installationJobId, uploadedAt])
}

model Signature {
  id                String @id @default(cuid())
  installationJobId String @unique
  customerId        String

  imageUrl String
  publicId String?

  signedByName   String
  signedAt       DateTime @default(now())
  acceptanceText String?

  installationJob InstallationJob @relation(fields: [installationJobId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, signedAt])
}

// ============================================================
// SERVICE TICKETS AND TICKET LINES
// ============================================================

model Ticket {
  id         String @id @default(cuid())
  companyId  String
  customerId String

  orderId      String?
  createdById  String?
  assignedToId String?

  ticketNumber String
  title        String
  description  String?

  status   TicketStatus   @default(NEW)
  priority TicketPriority @default(MEDIUM)

  reportedAt  DateTime  @default(now())
  assignedAt  DateTime?
  resolvedAt  DateTime?
  confirmedAt DateTime?
  closedAt    DateTime?

  resolutionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  order SalesOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdBy User? @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)

  assignedTo User? @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  lines    TicketLine[]
  invoices Invoice[]

  @@unique([companyId, ticketNumber])
  @@index([companyId, status, priority, reportedAt])
  @@index([customerId, status])
  @@index([orderId])
  @@index([assignedToId, status])
}

model TicketLine {
  id       String @id @default(cuid())
  ticketId String

  productId      String?
  serialNumberId String?

  type        TicketLineType
  description String

  quantity Decimal @default(1) @db.Decimal(12, 3)

  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  isWarrantyCovered Boolean @default(false)

  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([serialNumberId])
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id         String @id @default(cuid())
  companyId  String
  customerId String

  orderId     String?
  ticketId    String?
  createdById String?

  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  subtotal    Decimal @db.Decimal(12, 2)
  gstAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  amountDue  Decimal @db.Decimal(12, 2)

  issuedAt DateTime?
  dueDate  DateTime?
  paidAt   DateTime?

  pdfUrl      String?
  pdfPublicId String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  order SalesOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  createdBy User? @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  lines InvoiceLine[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status, dueDate])
  @@index([customerId, status])
  @@index([orderId])
  @@index([ticketId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  productId String?

  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  gstRate Decimal @default(18) @db.Decimal(5, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

// ============================================================
// SUBSIDY TRACKING
// ============================================================

model SubsidyApplication {
  id         String @id @default(cuid())
  companyId  String
  customerId String

  applicationNumber String?
  status            SubsidyStatus @default(NOT_STARTED)

  expectedAmount Decimal @default(0) @db.Decimal(12, 2)
  receivedAmount Decimal @default(0) @db.Decimal(12, 2)

  documentsSubmitted Boolean   @default(false)
  submittedAt        DateTime?
  approvedAt         DateTime?
  receivedAt         DateTime?

  authority       String?
  referenceNumber String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([companyId, applicationNumber])
  @@index([companyId, status, createdAt])
  @@index([customerId, status])
}

// ============================================================
// TECHNICIAN TIME AND JOB COSTING
// ============================================================

model TimeEntry {
  id                String  @id @default(cuid())
  companyId         String
  userId            String
  orderId           String
  installationJobId String?

  startTime DateTime
  endTime   DateTime?
  hours     Decimal?  @db.Decimal(8, 2)

  hourlyRate Decimal @db.Decimal(12, 2)
  labourCost Decimal @default(0) @db.Decimal(12, 2)

  description String?
  approved    Boolean   @default(false)
  approvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  installationJob InstallationJob? @relation(fields: [installationJobId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, startTime])
  @@index([orderId, startTime])
  @@index([installationJobId])
}

model CostEntry {
  id        String @id @default(cuid())
  companyId String
  orderId   String

  category    String
  description String
  amount      Decimal @db.Decimal(12, 2)

  incurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([companyId, category, incurredAt])
  @@index([orderId, incurredAt])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String  @id @default(cuid())
  companyId String
  userId    String?

  type   NotificationType
  status NotificationStatus @default(UNREAD)

  title      String
  message    String
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([entityType, entityId])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  actorId   String?

  action     AuditAction
  entityType String
  entityId   String

  oldValue Json?
  newValue Json?
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ============================================================
// READ-ONLY DASHBOARD SHARE LINKS
// ============================================================

model DashboardShareLink {
  id        String @id @default(cuid())
  companyId String

  // Store a cryptographic hash of the random share token,
  // never the raw token.
  tokenHash String @unique

  createdById  String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, expiresAt, revokedAt])
}
